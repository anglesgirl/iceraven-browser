{
    "name": "OnlyFans static URL rewrite",
    "description": "Redirects static2.onlyfans.com requests to onlyfans.com.",
    "version": "1.0.1",
    "manifest_version": 3,
    "icons": {
        "48": "icons/icon.svg",
        "96": "icons/icon.svg"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "requestcontrol-iceraven@anglesgirl.local",
            "strict_min_version": "140.0"
        }
    },
    "permissions": ["webRequest", "webRequestBlocking"],
    "host_permissions": ["*://static2.onlyfans.com/*"],
    "background": {
        "scripts": ["src/background.js"]
    }
}
