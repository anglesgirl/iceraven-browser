{
  "manifest_version": 2,
  "name": "AO3 Chinese",
  "version": "1.9.0",
  "description": "内置 AO3 中文阅读体验增强脚本。",
  "browser_specific_settings": {
    "gecko": {
      "id": "ao3-chinese@iceraven-browser"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://archiveofourown.org/*",
        "https://archiveofourown.org/*",
        "http://www.archiveofourown.org/*",
        "https://www.archiveofourown.org/*",
        "http://archiveofourown.gay/*",
        "https://archiveofourown.gay/*"
      ],
      "js": [
        "ao3-chinese-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://translate.googleapis.com/*",
    "https://translate-pa.googleapis.com/*",
    "https://edge.microsoft.com/*",
    "https://api-edge.cognitive.microsofttranslator.com/*",
    "https://api.anthropic.com/*",
    "https://api.cerebras.ai/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api-inference.modelscope.cn/*",
    "https://api.openai.com/*",
    "https://api.siliconflow.cn/*",
    "https://api.together.xyz/*",
    "https://open.bigmodel.cn/*",
    "https://fanyi.baidu.com/*",
    "https://transmart.qq.com/*",
    "https://cdnjs.cloudflare.com/*"
  ]
}
